# ─────────────────────────────────────────────────────────────────────────────
# Ariiti Admin Web — environment variables
#
# IMPORTANT
#   Only VITE_* variables are exposed to the browser bundle.
#   NEVER put database credentials, private keys, JWT signing secrets,
#   service secrets or backend credentials here.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Ariiti API Gateway. This is the ONLY entry point between
# this frontend and any backend microservice (identity, users, stores, ...).
VITE_API_GATEWAY_URL=http://localhost:8000/api

# Display name used in UI chrome / notifications.
VITE_APP_NAME=Ariiti Admin

# Default locale. Supported values: en, om, am.
VITE_DEFAULT_LOCALE=en
