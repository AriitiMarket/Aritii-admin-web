{
  "name": "aritii-admin-web",
  "version": "0.2.0",
  "private": true,
  "description": "Aritii Market Admin Web — React + Vite + TypeScript + React Router + REST (API Gateway)",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "yarn": "Please use npm instead."
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:lifecycle && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:map": "node scripts/test-map-geo.mjs",
    "test:lifecycle": "node scripts/check-delivery-lifecycle.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "preview": "vite preview",
    "prettier": "prettier --write src",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@types/leaflet": "^1.9.12",
    "chart.js": "^4.4.4",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eslint-plugin-unused-imports": "^4.1.4",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.3"
  }
}
