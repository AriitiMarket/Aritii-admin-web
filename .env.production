# Production build defaults.
# The deployed Aritii API Gateway URL must be supplied at build/deploy time
# via the CI/CD environment (VITE_API_GATEWAY_URL=https://...). Keeping it
# empty here prevents hardcoding a production endpoint in the repository.
VITE_API_GATEWAY_URL=
VITE_APP_NAME=Aritii Admin
VITE_DEFAULT_LOCALE=en
